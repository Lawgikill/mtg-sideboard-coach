{
  "name": "mtg-sideboard-coach",
  "private": true,
  "version": "1.3.0",
  "description": "A personal Magic: The Gathering sideboarding planner for Standard decks.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "npm run build && node electron/launch.cjs",
    "build": "tsc -b && vite build",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "generate-icon": "node scripts/generate-icon.cjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.local.mtg-sideboard-coach",
    "productName": "MTG Sideboard Coach",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**"
    ],
    "extraResources": [
      {
        "from": "build/traineddata",
        "to": "traineddata"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MTG Sideboard Coach",
      "deleteAppDataOnUninstall": false,
      "artifactName": "mtg-sideboard-coach-setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Lawgikill",
        "repo": "mtg-sideboard-coach"
      }
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.17.0",
    "mana-font": "^1.18.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "sharp": "^0.33.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
